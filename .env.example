# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cadence_ai"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# Anthropic
ANTHROPIC_API_KEY="your-anthropic-key"

# SendGrid
SENDGRID_API_KEY="your-sendgrid-key"
SENDGRID_FROM_EMAIL="outreach@yourdomain.com"
SENDGRID_INBOUND_PARSE_DOMAIN="parse.yourdomain.com"

# Stripe
STRIPE_SECRET_KEY="your-stripe-secret-key"
STRIPE_PUBLISHABLE_KEY="your-stripe-publishable-key"
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret"
STRIPE_STARTER_PRICE_ID="price_starter"
STRIPE_GROWTH_PRICE_ID="price_growth"

# LinkedIn (Unipile)
UNIPILE_API_KEY="your-unipile-key"
UNIPILE_BASE_URL="https://api.unipile.com"

# Reddit
REDDIT_CLIENT_ID="your-reddit-client-id"
REDDIT_CLIENT_SECRET="your-reddit-client-secret"
REDDIT_USER_AGENT="CadenceAI/1.0"

# Pinecone
PINECONE_API_KEY="your-pinecone-key"
PINECONE_ENVIRONMENT="your-pinecone-env"
PINECONE_INDEX="cadence-ai-memory"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
